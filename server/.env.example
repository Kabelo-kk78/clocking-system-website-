# ─────────────────────────────────────────────
# Server environment (copy this file to server/.env)
# Used by Express + firebase-admin when running the real API.
#
# The server will start without these, but Firestore and Auth
# routes will fail until valid credentials are provided.
# ─────────────────────────────────────────────

# ── Firebase Admin SDK ────────────────────────
# Generate these in Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alt: base64 of the whole service-account JSON (handy on Vercel where
# multi-line values are painful). If set, the three values above are ignored.
FIREBASE_SERVICE_ACCOUNT_B64=

# ── Server ────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Location / Geofence ───────────────────────
DEFAULT_RADIUS_METRES=50
MAX_GPS_ACCURACY_METRES=50

# ── QR Code / Shifts ──────────────────────────
# Two auto-generated QRs per day (no night shift):
#   - Morning shift:    valid 08:00–08:15  → staff scan to CLOCK IN.
#   - Close of business: valid 16:30–17:00 → staff scan to CLOCK OUT.
# Times are in SHIFT_TIMEZONE (Africa/Johannesburg).
QR_MORNING_START=08:00
QR_MORNING_END=08:15
QR_COB_START=16:30
QR_COB_END=17:00
SHIFT_CLOSE_OF_BUSINESS=16:30
SHIFT_TIMEZONE=Africa/Johannesburg

# ── Auto-email today's QR to employees ─────────
# When a shift window opens, the server emails that shift's QR to every active
# employee. Logs to console until an email provider is configured below.
QR_EMAIL_AUTO=true
QR_EMAIL_CHECK_SECONDS=30

# ─────────────────────────────────────────────
# Email delivery (Daily QR + real-time clock in/out emails)
#
# TWO digits of the API key style, you can use Resend EITHER SMTP:
#
#   RESEND  → API key from https://resend.com/api-keys
#   SMTP    → ANY smtp provider (Gmail, Outlook, Mailgun, Mailtrap, ...)
#
# If neither is configured the server still works: emails are logged to the
# console and recorded in Firestore → `emailsSent`. For REAL inbox delivery
# you MUST configure one of the providers (see "Inbox, not spam" below).
# ─────────────────────────────────────────────

# ── Resend ────────────────────────────────────
# Get an API key at https://resend.com/api-keys.
# Senders must be verified: https://resend.com/domains
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Verified sender (default is the sandbox onboarding@resend.dev address)
RESEND_FROM=MDIHub Clocking <onboarding@resend.dev>

# ── SMTP (alternative to Resend) ──────────────
# Examples: Gmail (smtp.gmail.com, 587, app password) or your mail host.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@your-domain.com
SMTP_PASS=your-smtp-password
SMTP_SECURE=false
SMTP_FROM=MDIHub Clocking <no-reply@your-domain.com>

# ── SMTP DKIM signing (strongly recommended for inbox delivery) ──
# Sign outbound mail so the receiving provider can verify the message came
# from your domain. Read the private key from your DNS DKIM record (PEM).
DKIM_DOMAIN_NAME=your-domain.com
DKIM_SELECTOR=default
DKIM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Admin notifications (clock in/out) ────────
# Optional. When set, each clock-in/out email also goes to these inboxes.
# When empty, the server automatically notifies all active admin users in Firestore.
ADMIN_NOTIFY_EMAIL=hr@your-domain.com

# ─────────────────────────────────────────────
# Inbox, not spam
# ─────────────────────────────────────────────
# Emails land in the inbox when the sending domain is authenticated:
#
#   1. SPF  — add a DNS TXT record allowing your SMTP host to send for the domain
#   2. DKIM — publish the public DKIM key in DNS (SMTP only; Resend does this
#             automatically once you verify your domain)
#   3. DMARC — add a DNS TXT record (_dmarc.your-domain.com) with a policy
#
# Resend: verifying your domain in Resend automates SPF + DKIM + DMARC for you.
# The sandbox sender (onboarding@resend.dev) can ONLY deliver to the account
# owner's own inbox — verify a domain before sending to all employees.
#
# SMTP: Gmail app passwords + your own domain or a mail provider that does
# SPF/DKIM for you (Mailgun, Postmark, SendGrid, Brevo, ...).

# ── Cron guard (daily email endpoint) ─────────
# Shared secret for the automated daily-email job (Vercel Cron, cron-job.org…).
# The endpoint is also callable by an authenticated admin without this header.
CRON_SECRET=change-me-to-a-long-random-string